@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<ECommerceSolution.Models.Product>
@{
    ViewBag.Title = "Управління товарами";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewBag.Title</h1>
    <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-success">
        Додати новий товар
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Назва</th>
            <th>Ціна</th>
            <th>Категорії</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Title</td>
            <td>@item.Price.ToString("F2") ₴</td>
            <td>
                @{
                    // Якщо товар належить до кількох категорій — виводимо всі через кому
                    var categoryNames = item.ProductCategories?
                        .Select(pc => pc.Category.Name)
                        .ToArray() 
                        ?? Array.Empty<string>();
                }
                @string.Join(", ", categoryNames)
            </td>
            <td class="text-end">
                <form asp-area="Admin"
                      asp-controller="Products"
                      asp-action="Delete"
                      asp-route-id="@item.Id"
                      method="post"
                      onsubmit="return confirm('Видалити «@item.Title»?');"
                      style="display:inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-danger">Видалити</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
