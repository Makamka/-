@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Адмінка</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { overflow-x: hidden; }
        .sidebar {
            width: 200px;
            height: 100vh;
            position: fixed;
            background: #343a40;
            color: #fff;
        }
        .sidebar a {
            color: #adb5bd;
            text-decoration: none;
            display: block;
            padding: .75rem 1rem;
        }
        .sidebar a.active,
        .sidebar a:hover {
            background: #495057;
            color: #fff;
        }
        .content {
            margin-left: 200px;
            padding: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h5 class="text-center py-3 border-bottom">Адмінка</h5>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Dashboard"?"active":"")">
            Dashboard
        </a>
        <a asp-area="Admin" asp-controller="Products" asp-action="Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Products"?"active":"")">
            Товари
        </a>
        <a asp-area="Admin" asp-controller="Users" asp-action="Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Users"?"active":"")">
            Користувачі
        </a>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Orders"?"active":"")">
            Замовлення
        </a>
        <hr class="border-secondary" />
        <a asp-area="" asp-controller="Home" asp-action="Index">Публічна частина</a>
        <a asp-area="" asp-controller="Catalog" asp-action="Index">Каталог сайту</a>
    </div>
    <div class="content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
