@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<ECommerceSolution.Models.ApplicationUser>
@{
    ViewBag.Title = "Управління користувачами";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // Отримаємо передані ролі
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>> 
                    ?? new Dictionary<string, IList<string>>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewBag.Title</h1>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-primary">
        Оновити
    </a>
</div>

<table class="table table-hover table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Email</th>
            <th>Ім’я</th>
            <th>Ролі</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var user in Model)
    {
        var roles = userRoles.ContainsKey(user.Id)
                  ? userRoles[user.Id]
                  : new List<string>();
        bool isAdmin = roles.Contains("Admin");
    <tr>
        <td>@user.Email</td>
        <td>@user.FullName</td>
        <td>@string.Join(", ", roles)</td>
        <td>
            <form asp-area="Admin" asp-controller="Users" asp-action="Delete"
                  method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@user.Id" />
                <button class="btn btn-sm btn-danger">Видалити</button>
            </form>

            @if (!isAdmin)
            {
                <form asp-area="Admin" asp-controller="Users" asp-action="MakeAdmin"
                      method="post" class="d-inline ms-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@user.Id" />
                    <button class="btn btn-sm btn-warning">Зробити адміністратором</button>
                </form>
            }
            else
            {
                <form asp-area="Admin" asp-controller="Users" asp-action="RevokeAdmin"
                      method="post" class="d-inline ms-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@user.Id" />
                    <button class="btn btn-sm btn-secondary">Забрати права</button>
                </form>
            }
        </td>
    </tr>
    }
    </tbody>
</table>
