@model IEnumerable<ECommerceSolution.Models.Order>

@{
    ViewBag.Title = "Замовлення";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">Замовлення</h1>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Клієнт</th>
            <th>Email</th>
            <th>Телефон</th>
            <th>Дата</th>
            <th>Статус</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td>@order.Id</td>
            <td>@order.FullName</td>
            <td>@order.Email</td>
            <td>@order.Phone</td>
            <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
            <td>
                @* Відобразимо український статус *@
                @{
                    var label = order.Status switch
                    {
                        "Pending"    => "Нове",
                        "Processing" => "В обробці",
                        "Shipped"    => "Відправлено",
                        "Completed"  => "Завершено",
                        "Cancelled"  => "Скасовано",
                        _            => order.Status
                    };
                }
                @label
            </td>
            <td>
                <a asp-area="Admin"
                   asp-controller="Orders"
                   asp-action="Details"
                   asp-route-id="@order.Id"
                   class="btn btn-sm btn-outline-primary">
                    Деталі
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>
